# Optional shared token gate for API endpoints (set the same value for API and UI).
# This is not per-user authentication; keep the service private and use real auth for deployment.
APP_API_TOKEN=
API_URL=http://127.0.0.1:8000

# Optional default provider keys. The Streamlit UI can accept a key per session.
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# RAG and chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4

# Upload and API security
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=15
UPLOAD_DIR=data/uploads
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# OCR (set the Tesseract executable path for your operating system)
OCR_ENABLED=true
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
